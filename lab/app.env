# Datos de la app para lab/app.sh, los workflows y el verificador.
APP_NOMBRE="VAmPI"
APP_PUERTO=5000
APP_RUTA_SALUD="/"
# VAmPI arranca con la base vacía: /createdb crea los usuarios y libros de ejemplo.
APP_RUTA_INICIAL="/createdb"
# vulnerable=1 activa las debilidades. Corregir no es poner vulnerable=0: es cambiar el código.
APP_DOCKER_ARGS=(-e vulnerable=1 -e tokentimetolive=3600)
APP_COMANDO=()
APP_IMAGEN_UPSTREAM=""
APP_ESPERA_SEGUNDOS=120
ZAP_MODO="api"
ZAP_OPENAPI="/openapi.json"
